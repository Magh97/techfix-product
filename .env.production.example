# Copiar a `.env` en el servidor de producción (junto a docker-compose.prod.yml)
# Generar secretos con: openssl rand -hex 32

# --- Base de datos ---
POSTGRES_DB=techstore
POSTGRES_USER=techstore
POSTGRES_PASSWORD=cambiar_por_una_contrasena_fuerte

# --- Dominio y CORS ---
# Sin http://
DOMAIN=tienda.midominio.com
CORS_ORIGIN=https://tienda.midominio.com

# --- Secretos JWT (openssl rand -hex 32) ---
JWT_SECRET=genera_un_secreto_aleatorio_largo
JWT_REFRESH_SECRET=genera_otro_secreto_aleatorio_largo

# --- Seed ---
# false = NO crear usuarios/datos demo en producción (los usuarios se crean por la UI)
SEED_DEMO=false

# --- SMTP real (notificaciones por correo) ---
SMTP_HOST=smtp.midominio.com
SMTP_PORT=587
SMTP_USER=no-reply@midominio.com
SMTP_PASS=password_del_correo
SMTP_FROM=no-reply@midominio.com

# --- WhatsApp real (Twilio) — notificaciones NOT-01..04 ---
# Si no se configuran, el envío se simula (log + registra 'enviado').
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # número de Twilio (sandbox o aprobado)
# TWILIO_DEFAULT_COUNTRY_CODE=52               # prefijo aplicado a teléfonos sin código de país

# --- Backups (BR-DAT-01) ---
BACKUP_RETENTION_DAYS=14

# --- Copia offsite (BR-DAT-01) ---
# Destino rclone (ej. s3-backups:techstore). Config:
#   1. En el host: `rclone config` → genera un remoto (S3/Drive/NAS).
#   2. Copia el archivo de configuración como `rclone.conf` junto a docker-compose.prod.yml.
#   3. Define el remoto aquí y levanta el servicio: `docker compose -f docker-compose.prod.yml up -d offsite`
RCLONE_REMOTE=s3-backups:techstore
