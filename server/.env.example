# Copiar a .env
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://techstore:techstore_dev@localhost:5432/techstore
JWT_SECRET=change_me_access_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Correo (opcional): si SMTP_HOST está vacío los correos se simulan en consola
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@techstore.local
